rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public creator portfolio media
    match /creators/{userId}/portfolio/{fileName} {
      // Anyone can view portfolio images and video showcases
      allow read: if true;
      
      // Creators can upload media into their own portfolio folder
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024 // Max 50MB
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('audio/.*'));
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
